# Скопируйте в .env и впишите свои значения. Файл .env в git не попадает.
# На сервере другие значения, см. docs/DEPLOY.md:
# APP_ORIGIN=https://ai-ideas.riadesign.ru
# NODE_ENV=production
# DEV_AUTH_BYPASS=0
# MAILRU_REDIRECT_URI=https://ai-ideas.riadesign.ru/api/auth/mailru/callback

# Пароль базы — буквы и цифры.
POSTGRES_PASSWORD=

# Локально страница открывается на http://localhost:8095
# Порт и адрес должны совпадать. 8080 на этом компьютере часто занят.
WEB_PORT=8095
APP_ORIGIN=http://localhost:8095
NODE_ENV=development

# Секрет подписи сессии. На компьютере можно оставить длинный набор букв и цифр.
JWT_SECRET=
# Ваш ящик Mail.ru. Чужой адрес войти не сможет.
OWNER_EMAILS=
# 1 — кнопка «Войти на этом компьютере». На сервере поставьте 0.
DEV_AUTH_BYPASS=1

# На компьютере можно оставить пустым. На сервере — данные приложения oauth.mail.ru.
MAILRU_CLIENT_ID=
MAILRU_CLIENT_SECRET=
MAILRU_REDIRECT_URI=

# Три модели через один OpenAI-совместимый адрес. Имена — как их знает этот адрес.
# Если LLM_MODELS пуст, используется одна OPENAI_MODEL.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
LLM_MODELS=gpt-4o-mini,gpt-4o,claude-sonnet-4-5
OPENAI_MODEL=
